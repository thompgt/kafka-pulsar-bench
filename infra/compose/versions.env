# Single source of truth for every container image version.
#
# Compose files reference these variables; nothing hardcodes a tag.
# Digests live alongside in images.lock and are recorded per benchmark run
# (requirement M-3) because tags are mutable and digests are not.
#
# Verified against the registries on 2026-08-18. See docs/adr/0001-version-matrix.md.
# Regenerate the lock with: scripts/resolve-digests.sh

# --- Systems under test -------------------------------------------------
# Latest stable patch of the current minor line for each project, chosen so
# neither broker is given a maturity advantage over the other.
KAFKA_IMAGE=apache/kafka
KAFKA_VERSION=4.2.1

PULSAR_IMAGE=apachepulsar/pulsar
PULSAR_VERSION=4.2.4

# --- Lakehouse ----------------------------------------------------------
ICEBERG_VERSION=1.10.1
ICEBERG_REST_IMAGE=apache/iceberg-rest-fixture
ICEBERG_REST_VERSION=1.10.1

MINIO_IMAGE=minio/minio
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MC_IMAGE=minio/mc
MC_VERSION=RELEASE.2025-04-16T18-13-26Z

# --- Engines ------------------------------------------------------------
# Flink 1.20 rather than 2.x: the Iceberg connector line is mature here and
# iceberg-flink-runtime-1.20 is published for ICEBERG_VERSION. Revisit at M5.
FLINK_IMAGE=flink
FLINK_VERSION=1.20.5-scala_2.12-java17
FLINK_MINOR=1.20

# Spark 3.5 with Scala 2.12: matches iceberg-spark-runtime-3.5_2.12.
SPARK_IMAGE=spark
SPARK_VERSION=3.5.6-python3
SPARK_MINOR=3.5
SCALA_VERSION=2.12

# --- Orchestration ------------------------------------------------------
AIRFLOW_IMAGE=apache/airflow
AIRFLOW_VERSION=3.0.3
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=16-alpine

# --- Harness ------------------------------------------------------------
# 3.12, not 3.13: some client and PySpark wheels still lag on 3.13.
PYTHON_VERSION=3.12
